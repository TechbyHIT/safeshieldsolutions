# Full redeploy from GitHub (survives SSH disconnect).
# Installed by: bash deploy/vps-redeploy.sh /root/safeshieldsolutions
[Unit]
Description=SafeShield Solutions — pull GitHub, publish sitemaps, start PM2 if standalone exists
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=ROOT=@ROOT@
ExecStart=/bin/bash @ROOT@/deploy/vps-run.sh @ROOT@
StandardOutput=append:/var/log/safeshield-deploy.log
StandardError=append:/var/log/safeshield-deploy.log
TimeoutStartSec=0
TimeoutStopSec=30
OOMScoreAdjust=-1000
MemoryMax=infinity
MemorySwapMax=infinity
TasksMax=infinity
LimitNOFILE=65535
Nice=-5
# Do not kill npm/next when unrelated sessions log out
KillMode=control-group

[Install]
WantedBy=multi-user.target
