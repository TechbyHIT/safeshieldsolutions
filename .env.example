# Site
NEXT_PUBLIC_SITE_URL="https://safeshieldsolutions.in"
NEXT_PUBLIC_SITE_NAME="SafeShield Solutions"

# Build — 0 = no pre-render for dynamic routes (ISR on first request)
NEXT_BUILD_STATIC_SERVICES=0
NEXT_BUILD_STATIC_CITY_SAMPLES=0

# PM2 / standalone (production)
PORT=3010
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Revalidation
REVALIDATION_SECRET="change-me-to-a-long-random-string"

# Admin (optional – protect admin routes)
ADMIN_SECRET="change-me-admin-secret"

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Contact form (optional)
CONTACT_EMAIL="info@safeshieldsolutions.in"
