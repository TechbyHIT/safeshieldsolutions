{
  "name": "babai-programmatic-seo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3010",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "build:next": "next build",
    "storage:report": "node scripts/storage-report.mjs",
    "deploy:prune": "node scripts/prune-production.mjs",
    "deploy:prod": "npm install --no-audit --no-fund && npm run build && npm run deploy:prune",
    "start": "next start -p 3010",
    "start:standalone": "node .next/standalone/server.js",
    "pm2:start": "pm2 start deploy/ecosystem.config.cjs",
    "pm2:reload": "pm2 reload deploy/ecosystem.config.cjs",
    "pm2:logs:setup": "pm2 install pm2-logrotate && pm2 set pm2-logrotate:max_size 8M && pm2 set pm2-logrotate:retain 5 && pm2 set pm2-logrotate:compress true",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "areas:generate": "tsx scripts/generate-hyderabad-areas.ts",
    "areas:generate:chennai": "tsx scripts/generate-chennai-areas.ts",
    "areas:generate:coimbatore": "tsx scripts/generate-coimbatore-areas.ts",
    "areas:generate:kochi": "tsx scripts/generate-kochi-areas.ts",
    "areas:generate:all": "tsx scripts/generate-hyderabad-areas.ts && tsx scripts/generate-chennai-areas.ts && tsx scripts/generate-coimbatore-areas.ts && tsx scripts/generate-kochi-areas.ts",
    "pages:count": "tsx scripts/page-count.ts",
    "seo:validate": "tsx scripts/seo-validate.ts",
    "content:audit": "tsx scripts/content-audit.ts",
    "duplicates:audit": "tsx scripts/duplicate-audit.ts",
    "links:audit": "tsx scripts/internal-link-audit.ts",
    "schema:audit": "tsx scripts/schema-audit.ts",
    "placeholder:audit": "tsx scripts/placeholder-audit.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.16.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
